//- chat 관련 내용을 실행하고 싶으면 chat_* -> * 로 이름 변경하고 실행
doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(http-equiv="X-UA-Compatible", content="IE=edge")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")
        title Noom
        link(rel="stylesheet", href="https://unpkg.com/mvp.css")
    body
        header
            h1 Noom
        main
            div#welcome
                form
                    input#roomName(placeholder="roomName", required, type="text")
                    input#nickname(placeholder="nickname" required, type="text")
                    button Enter Room
                h4 Open Rooms:
                ul
            div#room
                h3
                ul
                form#msg
                    input(placeholder="message", required, type="text")
                    button Send
                form#nickname
                    input(placeholder="nickname", required, type="text")
                    button nickname Change
        script(src="/socket.io/socket.io.js") 
        script(src="/public/js/app.js") 